<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>TheConcernedCat.ConcernedTeamster</RootNamespace>
    <AssemblyName>TheConcernedCat.ConcernedTeamster</AssemblyName>
    <Version>1.0.5</Version>
    <FileAlignment>512</FileAlignment>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Authors>Eren Cansunar</Authors>
    <Company>The Concerned Cat</Company>
    <Product>Concerned Teamster</Product>
    <Copyright>Copyright © 2026 Eren Cansunar</Copyright>
    <RepositoryUrl>https://github.com/Weakened/ConcernedCatMods</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="RepositoryUrl" Value="https://github.com/Weakened/ConcernedCatMods" />
  </ItemGroup>

  <ItemGroup>
    <!-- Game-free shared source for the Gunnar worker runtime (docs/settlement/cart-and-collection):
         worker identities, authority, retries, and the cross-product capability contracts. -->
    <Compile Include="..\Shared\Workers\**\*.cs" LinkBase="Workers" />
    <Compile Include="..\Shared\Interop\**\*.cs" LinkBase="Interop" />
    <!-- #411: the one path scrubber and the one failure wording, shared as
         source because products never reference each other and three
         independent copies is how #388 had to be fixed twice. -->
    <Compile Include="..\Shared\Diagnostics\**\*.cs" LinkBase="Diagnostics" />
  </ItemGroup>

  <ItemGroup>
    <!-- CT-008: versioned calibration data ships inside the DLL; the same
         file is embedded into the test assembly so tests prove the shipped
         bytes. The stable logical name decouples the resource from folder
         renames. -->
    <EmbeddedResource Include="Data\CartLoadCalibration.txt" LogicalName="CT.Data.CartLoadCalibration" />
    <EmbeddedResource Include="Data\CartDescentCalibration.txt" LogicalName="CT.Data.CartDescentCalibration" />
  </ItemGroup>

  <ItemGroup>
    <!-- CNPC-R2 (#381), adopting #371: the shared NPC runtime ships as its own
         package and is referenced, never copied. <Private>false</Private> keeps
         its DLL out of this product's output and therefore out of its ZIP, so a
         player installs it once, from its own Thunderstore package, which is
         pinned in Package/thunderstore.toml. The BepInDependency in Plugin.cs
         turns a missing package into one clear line at load. All four together
         or none: tools/validate_repo.py check_library_consumers. -->
    <ProjectReference Include="..\ConcernedNPC\ConcernedNPC.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JotunnLib" Version="2.29.2" />
  </ItemGroup>
</Project>
