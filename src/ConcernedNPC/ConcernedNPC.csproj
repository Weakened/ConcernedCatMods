<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>TheConcernedCat.ConcernedNPC</RootNamespace>
    <AssemblyName>TheConcernedCat.ConcernedNPC</AssemblyName>
    <Version>0.2.0</Version>
    <FileAlignment>512</FileAlignment>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Authors>Eren Cansunar</Authors>
    <Company>The Concerned Cat</Company>
    <Product>Concerned NPC</Product>
    <Copyright>Copyright © 2026 Eren Cansunar</Copyright>
    <RepositoryUrl>https://github.com/Weakened/ConcernedCatMods</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="RepositoryUrl" Value="https://github.com/Weakened/ConcernedCatMods" />
  </ItemGroup>

  <!-- CNPC-000 (#371): this project references NO product, and the validator
       enforces it (check_library_consumers). A shared runtime that reached back
       into one of its consumers would be a circular dependency, and the whole
       reason this package exists is that a fix to it can ship on its own. -->

  <ItemGroup>
    <PackageReference Include="JotunnLib" Version="2.29.2" />
  </ItemGroup>
</Project>
