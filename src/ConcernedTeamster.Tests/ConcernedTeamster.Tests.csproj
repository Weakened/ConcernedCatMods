<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The pure domain sources are compiled directly into the test assembly:
         they have no Unity/BepInEx dependencies, and shipping stays a single
         plugin DLL because no extra domain assembly exists. -->
    <Compile Include="..\ConcernedTeamster\Domain\**\*.cs" LinkBase="Domain" />
    <Compile Include="..\Shared\Workers\**\*.cs" LinkBase="Workers" />
    <Compile Include="..\Shared\Interop\**\*.cs" LinkBase="Interop" />
    <!-- #411: the one path scrubber and the one failure wording, shared as
         source because products never reference each other and three
         independent copies is how #388 had to be fixed twice. -->
    <Compile Include="..\Shared\Diagnostics\**\*.cs" LinkBase="Diagnostics" />
    <!-- CT-008: the exact calibration file the plugin ships, embedded under
         the same logical name so LoadCalibrationSource resolves it in both
         assemblies and tests prove the shipped bytes. -->
    <EmbeddedResource Include="..\ConcernedTeamster\Data\CartLoadCalibration.txt" LogicalName="CT.Data.CartLoadCalibration" />
    <EmbeddedResource Include="..\ConcernedTeamster\Data\CartDescentCalibration.txt" LogicalName="CT.Data.CartDescentCalibration" />
  </ItemGroup>

  <ItemGroup>
    <!-- #374: the library's game-free sources, because Teamster's Domain layer
         now speaks NpcContainerDecision and these tests compile that layer as
         source.

         This deliberately does NOT establish that the facade is reachable from
         outside the package - `internal` is visible to a source include, so
         these tests would compile either way. That property is proven by the
         PRODUCT build instead: ConcernedTeamster is net48 and references
         ConcernedNPC as an assembly, so `Domain/Workers/ContainerPermissionRows`
         compiling at all in scripts/verify.ps1 is the proof, and a ProjectReference
         from here could not be (net10.0 cannot reference net48). The validator's
         #374 rule pins it so it stays true rather than being true by accident.

         #379 widened this from three folders (Containers, Storage, Work) to
         everything except Body/ and Plugin.cs, exactly as ConcernedSteward.Tests
         links it: Gunnar's tour plan (Domain/Collection/GunnarTourPlan.cs) speaks
         the interruption layer, which needs Roles, Bodies, Custody, Reservations
         and Persistence beside it. None of those names a Unity, BepInEx or Jotunn
         type. Body/ does (BaseAI, Humanoid, ZNetView, Jotunn's prefab manager) and
         Plugin.cs is the BepInEx entry point, so both stay out and this project
         stays provable on a machine with no game installed. The same caveat as
         above applies to the widened set: `internal` is visible here, so the
         product build, not this one, proves the tour plan uses only the
         library's public surface. -->
    <Compile Include="..\ConcernedNPC\**\*.cs"
             Exclude="..\ConcernedNPC\Plugin.cs;..\ConcernedNPC\Body\**\*.cs;..\ConcernedNPC\bin\**\*.cs;..\ConcernedNPC\obj\**\*.cs"
             LinkBase="Library" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
