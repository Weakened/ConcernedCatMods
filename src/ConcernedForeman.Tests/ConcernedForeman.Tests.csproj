<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>TheConcernedCat.ConcernedForeman.Tests</AssemblyName>
    <!-- The linked product sources are written for the plugin's net48 target and
         C# 10. Nothing here may depend on a newer language feature, so the
         sources keep compiling in both places. -->
    <LangVersion>10</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- #316 / review R2 M4: no test project compiled ConcernedForeman at all,
         so the adapter layer - the only code that touches the game - was proved
         by reading. These are the shipped sources, linked exactly as the shared
         ones are elsewhere, and compiled against the vanilla surface stubbed in
         VanillaStubs.cs. The stubs are the GAME; the logic under test is the
         real shipped file, never a copy of it. -->
    <Compile Include="..\ConcernedForeman\Runtime\Custody\EngineInventoryPorts.cs" Link="Product/EngineInventoryPorts.cs" />
    <Compile Include="..\ConcernedForeman\Runtime\Custody\WorkerBody.cs" Link="Product/WorkerBody.cs" />
    <Compile Include="..\ConcernedForeman\Runtime\Settlement\ToolClassifier.cs" Link="Product/ToolClassifier.cs" />
    <Compile Include="..\ConcernedForeman\Runtime\Settlement\SettlementTargets.cs" Link="Product/SettlementTargets.cs" />
    <!-- #286: the housing adapter. It had no coverage at all, which is why two
         rounds of independent review found defects in it that no test could see:
         the ownership read, both budgets, the loaded-ground check and the bed key
         were all eyeballed. -->
    <Compile Include="..\ConcernedForeman\Runtime\Settlement\WorldHousing.cs" Link="Product/WorldHousing.cs" />
    <Compile Include="..\ConcernedForeman\Runtime\SitePoints.cs" Link="Product/SitePoints.cs" />

    <!-- #380 (CNPC-R1): the construction domain. Game-free on purpose - the
         blueprint, the real-recipe arithmetic, the phase order, the placement
         gate's decision table and the round loop all decide things that can be
         proved with no game installed, and the folder carries no Unity type so
         it compiles here exactly as it does in the product. The game-bound half
         of the same feature lives under Runtime/Construction and is linked
         below against the vanilla stubs. -->
    <Compile Include="..\ConcernedForeman\Domain\Construction\**\*.cs" LinkBase="Construction" />

    <!-- #380: the adapters that read the real recipe, the real ward and the
         real ground. These are the only construction files that touch the game,
         and they are the ones a review would otherwise have to take on trust. -->
    <Compile Include="..\ConcernedForeman\Runtime\Construction\**\*.cs"
             Exclude="..\ConcernedForeman\Runtime\Construction\BuildCommand.cs"
             LinkBase="Product/Construction" />
    <!-- #380: the C1 work seams the construction runtime is written against.
         ONE FILE, not the folder: WorkSeams.cs is game-free apart from a Vector3
         and declares the motion and custody interfaces the build loop's adapters
         consume, so linking it lets the whole execution chain - the loop, the
         walk adapter, the materials adapter and the composition root - compile and
         be driven here. The rest of Runtime/Work and Runtime/Collection is not
         linked: it names ForemanWorkerAI and the game's own scene, which is a
         different stub surface from this project's. -->
    <Compile Include="..\ConcernedForeman\Runtime\Work\WorkSeams.cs" Link="Product/WorkSeams.cs" />

    <!-- BuildCommand is a Jotunn ConsoleCommand and nothing else: it forwards
         its words to BuildOrderRuntime, which IS linked and IS tested. Stubbing
         Jotunn's entity base class to prove a forward is not evidence about
         anything, and it is why CollectCommand is not linked here either. -->

    <!-- The Concerned NPC adoption: Thorstein's durable facts, his role
         declaration, and the mode hold that reads and writes the library's one
         arbiter instead of an owner this product builds for itself. Game-free on
         purpose, which is what lets the whole adoption - including the
         fail-closed answers for an identity the library never accepted - be
         proved with no game installed. -->
    <Compile Include="..\ConcernedForeman\Domain\Npc\**\*.cs" LinkBase="Npc" />

    <!-- The game-free half of the Concerned NPC library, LINKED and not
         referenced.

         The product REFERENCES the library as an assembly, which is the whole
         point of it being a package. A net10 test host cannot load that net48
         output, so the sources are linked here instead, exactly as
         ConcernedSteward.Tests links them and for the same reason this project's
         own adapters are linked: a test that passed against a copy would prove
         nothing about what ships.

         One consequence worth knowing: linking makes the library's INTERNAL
         members visible here, including NpcRoleRegistry's own constructor. That
         is what lets these tests build a private registry per test instead of
         reaching for the process-wide Shared one, which every other test running
         in parallel would share. The product cannot do that and does not: it uses
         Shared, which is the one the arbiter's guarantee is about.

         Everything EXCEPT Body/ and Plugin.cs. Body/ names BaseAI, Humanoid,
         ZNetView and Jotunn's prefab manager, and this project's VanillaStubs.cs
         is a DIFFERENT set of stand-ins from the library suite's; linking both
         would be two games in one assembly. Plugin.cs is the BepInEx entry
         point. -->
    <Compile Include="..\ConcernedNPC\**\*.cs"
             Exclude="..\ConcernedNPC\Plugin.cs;..\ConcernedNPC\Body\**\*.cs;..\ConcernedNPC\bin\**\*.cs;..\ConcernedNPC\obj\**\*.cs"
             LinkBase="ConcernedNPC" />

    <!-- The game-free layers those sources sit on, the same way
         Shared.Settlement.Tests links them. -->
    <Compile Include="..\Shared\Settlement\**\*.cs" LinkBase="Settlement" />
    <Compile Include="..\Shared\Workers\**\*.cs" LinkBase="Workers" />
    <Compile Include="..\Shared\Interop\**\*.cs" LinkBase="Interop" />
    <!-- #411: the one path scrubber and the one failure wording, shared as
         source because products never reference each other and three
         independent copies is how #388 had to be fixed twice. -->
    <Compile Include="..\Shared\Diagnostics\**\*.cs" LinkBase="Diagnostics" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
