<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>TheConcernedCat.ConcernedForeman</RootNamespace>
    <AssemblyName>TheConcernedCat.ConcernedForeman</AssemblyName>
    <Version>0.1.0</Version>
    <FileAlignment>512</FileAlignment>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Authors>Eren Cansunar</Authors>
    <Company>The Concerned Cat</Company>
    <Product>Concerned Foreman</Product>
    <Copyright>Copyright © 2026 Eren Cansunar</Copyright>
    <RepositoryUrl>https://github.com/Weakened/ConcernedCatMods</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="RepositoryUrl" Value="https://github.com/Weakened/ConcernedCatMods" />
  </ItemGroup>

  <ItemGroup>
    <!-- CF-SET-002: the settlement layer is shared as SOURCE, not as an
         assembly, exactly like the companion layer. This one line compiles the
         same internal types into Foreman's own DLL, so packaging never gains a
         dependency and no product ever references another. The sources are pure
         C# with no Unity/BepInEx/Jotunn types, which is what lets
         Shared.Settlement.Tests link them and exercise the whole decision
         surface game-free. -->
    <Compile Include="..\Shared\Settlement\**\*.cs" LinkBase="Settlement" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JotunnLib" Version="2.29.2" />
  </ItemGroup>
</Project>
