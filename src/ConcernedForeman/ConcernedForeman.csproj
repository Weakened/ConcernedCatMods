<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>TheConcernedCat.ConcernedForeman</RootNamespace>
    <AssemblyName>TheConcernedCat.ConcernedForeman</AssemblyName>
    <Version>0.1.0</Version>
    <FileAlignment>512</FileAlignment>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Authors>Eren Cansunar</Authors>
    <Company>The Concerned Cat</Company>
    <Product>Concerned Foreman</Product>
    <Copyright>Copyright © 2026 Eren Cansunar</Copyright>
    <RepositoryUrl>https://github.com/Weakened/ConcernedCatMods</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="RepositoryUrl" Value="https://github.com/Weakened/ConcernedCatMods" />
  </ItemGroup>

  <ItemGroup>
    <!-- CF-SET-002: the settlement layer is shared as SOURCE, not as an
         assembly, exactly like the companion layer. This one line compiles the
         same internal types into Foreman's own DLL, so packaging never gains a
         dependency and no product ever references another. The sources are pure
         C# with no Unity/BepInEx/Jotunn types, which is what lets
         Shared.Settlement.Tests link them and exercise the whole decision
         surface game-free. -->
    <Compile Include="..\Shared\Settlement\**\*.cs" LinkBase="Settlement" />
    <!-- Game-free worker authority/actor-mode contracts and the cross-product
         capability contracts (docs/settlement/cart-and-collection). -->
    <Compile Include="..\Shared\Workers\**\*.cs" LinkBase="Workers" />
    <Compile Include="..\Shared\Interop\**\*.cs" LinkBase="Interop" />
    <!-- #411: the one path scrubber and the one failure wording, shared as
         source because products never reference each other and three
         independent copies is how #388 had to be fixed twice. -->
    <Compile Include="..\Shared\Diagnostics\**\*.cs" LinkBase="Diagnostics" />
    <!-- Game-free ladder geometry, mounting, climbing and safety
         (docs/mods/concerned-foreman/LADDERS.md). The Valheim side lives in
         this product, under Runtime/Ladders. -->
    <Compile Include="..\Shared\Ladders\**\*.cs" LinkBase="Ladders" />
  </ItemGroup>

  <!-- Concerned Foreman is a consumer of the Concerned NPC LIBRARY. A library is
       not a product and this is not a cross-product reference: it ships no
       gameplay, it depends on no product, and the validator proves both.

       Four rules hold together or not at all (check_library_consumers):

         1. this ProjectReference, with Private FALSE, so the library's DLL is
            never copied into this product's output and can never reach this
            product's ZIP - a player installs it once, from its own package;
         2. a TheConcernedCat-ConcernedNPC pin in Package/thunderstore.toml, so
            the storefront fetches it;
         3. a BepInDependency on com.theconcernedcat.valheim.concernednpc in
            Plugin.cs, so a missing package is one clear line at load rather than
            a null reference later in somebody's evening;
         4. no `new ActorModeOwner(` anywhere in this product, because one
            identity with two mode owners makes the never-coexist rule advice
            rather than enforcement.

       Rule 4 is why this reference arrives with Domain/Npc: Thorstein's mode now
       comes from the library's one arbiter, through ArbiterActorMode, and
       CollectionRuntime no longer constructs an owner of its own. -->
  <ItemGroup>
    <ProjectReference Include="..\ConcernedNPC\ConcernedNPC.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JotunnLib" Version="2.29.2" />
  </ItemGroup>
</Project>
