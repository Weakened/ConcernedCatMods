<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>TheConcernedCat.ConcernedSteward</RootNamespace>
    <AssemblyName>TheConcernedCat.ConcernedSteward</AssemblyName>
    <Version>0.1.0</Version>
    <FileAlignment>512</FileAlignment>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Authors>Eren Cansunar</Authors>
    <Company>The Concerned Cat</Company>
    <Product>Concerned Steward</Product>
    <Copyright>Copyright © 2026 Eren Cansunar</Copyright>
    <RepositoryUrl>https://github.com/Weakened/ConcernedCatMods</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="RepositoryUrl" Value="https://github.com/Weakened/ConcernedCatMods" />
  </ItemGroup>

  <ItemGroup>
    <!-- CS-001: shared source, compiled into this product's own DLL exactly as
         it is into Foreman's and Teamster's. Nothing here is a reference to
         another product.

         Worker identities, the work-authority rule, the single actor-mode
         owner, bounded retries and the traversal capability seam. Adopted
         whole: every type in the area is on the Steward's path. -->
    <Compile Include="..\Shared\Workers\**\*.cs" LinkBase="Workers" />

    <!-- The cross-product capability map, for the optional restock provider
         probe. Adopted whole. -->
    <Compile Include="..\Shared\Interop\**\*.cs" LinkBase="Interop" />

    <!-- The settlement area is adopted as a NAMED CLOSED SUBSET, not whole,
         and that is deliberate.

         What is taken: Identity (settlement/worker/request slugs and scopes),
         Worker (SitePoint and the movement planner the other NPCs walk on),
         Designations (the designation book, its identity-epoch staleness rule
         and the ward seam) and Storage (the atomic write and the record
         trailer).

         What is not: Collection, Cooperation, Custody, Journal, Orders,
         Recruitment, Register and Tools — roughly sixteen thousand lines of
         Thorstein's collection-order and haul-cooperation machinery. The
         Steward has no collection orders, no quotas and no cart, so compiling
         them here would be dead weight in the shipped DLL and, worse, would
         couple two products' release cadence through shared source, which is
         the exact thing the source-sharing rule exists to avoid.

         This is a four-item adoption where the convention describes one, and
         it is safe only because the four folders are a CLOSED dependency set:
         their single cross-area `using` is TheConcernedCat.Settlement.Worker,
         which is inside the set. That is not a claim, it is a test —
         SharedSubsetClosureTests reads these sources and fails the build if
         anything inside the subset ever reaches outside it. Without that test
         this arrangement would be a trap for whoever next edits Foreman. -->
    <Compile Include="..\Shared\Settlement\Identity\**\*.cs" LinkBase="Settlement\Identity" />
    <Compile Include="..\Shared\Settlement\Worker\**\*.cs" LinkBase="Settlement\Worker" />
    <Compile Include="..\Shared\Settlement\Designations\**\*.cs" LinkBase="Settlement\Designations" />
    <Compile Include="..\Shared\Settlement\Storage\**\*.cs" LinkBase="Settlement\Storage" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JotunnLib" Version="2.29.2" />
  </ItemGroup>
</Project>
