<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>TheConcernedCat.ConcernedSteward.Tests</AssemblyName>
    <!-- The linked product sources are written for the plugin's net48 target and
         C# 10. Nothing here may depend on a newer language feature, so the
         sources keep compiling in both places. -->
    <LangVersion>10</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- The whole game-free domain, linked rather than copied: these are the
         shipped files, and a test that passed against a copy would prove
         nothing about what ships. -->
    <Compile Include="..\ConcernedSteward\Domain\**\*.cs" LinkBase="Product\Domain" />

    <!-- The adapters, compiled against the vanilla surface stubbed in
         VanillaStubs.cs. These are the only Steward sources that touch the
         game, and one of them can destroy a player's item, so leaving them out
         would mean the layer that matters most was proved by reading. The stubs
         are the GAME; every type under test here is the real shipped file.

         The Jotunn prefab builder, the BaseAI subclass and the plugin wiring
         are deliberately NOT linked: BaseAI's protected members and Jotunn's
         prefab manager are not honestly stubbable, and a stub elaborate enough
         to host them would be testing itself. That boundary is the same one
         Concerned Foreman drew, for the same reason. -->
    <Compile Include="..\ConcernedSteward\Runtime\StewardIdentity.cs" Link="Product\Runtime\StewardIdentity.cs" />
    <Compile Include="..\ConcernedSteward\Runtime\WorldFuelTargets.cs" Link="Product\Runtime\WorldFuelTargets.cs" />
    <Compile Include="..\ConcernedSteward\Runtime\WorldItemStores.cs" Link="Product\Runtime\WorldItemStores.cs" />
    <Compile Include="..\ConcernedSteward\Runtime\StewardBody.cs" Link="Product\Runtime\StewardBody.cs" />
    <Compile Include="..\ConcernedSteward\Runtime\StewardCensus.cs" Link="Product\Runtime\StewardCensus.cs" />
    <Compile Include="..\ConcernedSteward\Runtime\StewardWorldFacts.cs" Link="Product\Runtime\StewardWorldFacts.cs" />


    <!-- CNPC-R3 (#382): the game-free half of the Concerned NPC library, linked
         and not referenced.

         The product REFERENCES the library as an assembly, which is the whole
         point of it being a package. A net10 test host cannot load that net48
         output, so the sources are linked here instead, exactly as
         ConcernedNPC.Tests links them and for the same reason the product's own
         adapters are linked: a test that passed against a copy would prove
         nothing about what ships.

         One consequence worth knowing: linking makes the library's INTERNAL
         members visible here, including NpcRoleRegistry's own constructor. That
         is what lets these tests build a private registry per test instead of
         reaching for the process-wide Shared one, which is shared with every
         other test running in parallel. The product cannot do that and does not:
         it uses Shared, which is the one the arbiter's guarantee is about.

         Everything EXCEPT Body/ and Plugin.cs. Body/ names BaseAI, Humanoid,
         ZNetView and Jotunn's prefab manager, and this project's
         VanillaStubs.cs is a DIFFERENT set of stand-ins from the library
         suite's; linking both would be two games in one assembly. Plugin.cs is
         the BepInEx entry point and would drag BepInEx into a project that is
         otherwise provable on a machine with no game installed. Everything
         else in the package - the job driver, the planning pipeline, the
         routing, the containers, the work areas - contains no Unity, BepInEx
         or Jotunn type at all, which is why it links cleanly. -->
    <Compile Include="..\ConcernedNPC\**\*.cs"
             Exclude="..\ConcernedNPC\Plugin.cs;..\ConcernedNPC\Body\**\*.cs;..\ConcernedNPC\bin\**\*.cs;..\ConcernedNPC\obj\**\*.cs"
             LinkBase="ConcernedNPC" />

    <!-- The same shared subset the product adopts, linked the same way, so the
         tests exercise exactly what ships. SharedSubsetClosureTests asserts the
         subset stays closed. -->
    <Compile Include="..\Shared\Workers\**\*.cs" LinkBase="Workers" />
    <Compile Include="..\Shared\Interop\**\*.cs" LinkBase="Interop" />
    <!-- #411: the one path scrubber and failure wording. -->
    <Compile Include="..\Shared\Diagnostics\**\*.cs" LinkBase="Diagnostics" />
    <Compile Include="..\Shared\Settlement\Identity\**\*.cs" LinkBase="Settlement\Identity" />
    <Compile Include="..\Shared\Settlement\Worker\**\*.cs" LinkBase="Settlement\Worker" />
    <Compile Include="..\Shared\Settlement\Designations\**\*.cs" LinkBase="Settlement\Designations" />
    <Compile Include="..\Shared\Settlement\Storage\**\*.cs" LinkBase="Settlement\Storage" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
