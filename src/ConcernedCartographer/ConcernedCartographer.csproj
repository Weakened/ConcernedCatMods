<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>TheConcernedCat.ConcernedCartographer</RootNamespace>
    <AssemblyName>TheConcernedCat.ConcernedCartographer</AssemblyName>
    <Version>1.0.4</Version>
    <FileAlignment>512</FileAlignment>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Authors>Eren Cansunar</Authors>
    <Company>The Concerned Cat</Company>
    <Product>Concerned Cartographer</Product>
    <Copyright>Copyright © 2026 Eren Cansunar</Copyright>
    <RepositoryUrl>https://github.com/Weakened/ConcernedCatMods</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="RepositoryUrl" Value="https://github.com/Weakened/ConcernedCatMods" />
  </ItemGroup>

  <ItemGroup>
    <!-- CC-NPC-001: the Concerned Companions layer is shared as SOURCE, not as
         an assembly. Every product that wants companions adds this one line and
         compiles the same internal types into its own DLL, so packaging never
         gains a dependency and no product ever references another. The sources
         are pure C# with no Unity/BepInEx/Jotunn types, which is what lets the
         test project link them and exercise the whole layer game-free. -->
    <Compile Include="..\Shared\Companions\**\*.cs" LinkBase="Companions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JotunnLib" Version="2.29.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- RC8 cc:* marker sprites, generated by tools/generate_icon_sprites.py.
         Stable logical names decouple the manifest from namespace/folder
         renames: CC.Icons.cc-road.png etc. -->
    <EmbeddedResource Include="Assets\Icons\*.png" LogicalName="CC.Icons.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
