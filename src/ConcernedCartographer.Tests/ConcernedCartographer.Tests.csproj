<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The pure domain sources are compiled directly into the test assembly:
         they have no Unity/BepInEx dependencies, and shipping stays a single
         plugin DLL because no extra domain assembly exists. -->
    <Compile Include="..\ConcernedCartographer\Domain\**\*.cs" LinkBase="Domain" />
    <Compile Include="..\ConcernedCartographer\Runtime\VanillaMessage.cs" Link="Runtime/VanillaMessage.cs" />
    <!-- CC-NPC-001: the same shared companion sources the plugin compiles, so
         the tests prove the shipped code rather than a copy of it. -->
    <Compile Include="..\Shared\Companions\**\*.cs" LinkBase="Companions" />
    <!-- #296: the work-area contract both the provider and any consumer
         compile, plus the capability map it is published through. -->
    <Compile Include="..\Shared\Interop\CapabilityMap.cs" Link="Interop/CapabilityMap.cs" />
    <Compile Include="..\Shared\Interop\WorkArea\**\*.cs" LinkBase="Interop/WorkArea" />
    <Compile Include="..\Shared\Interop\WorkOrders\**\*.cs" LinkBase="Interop/WorkOrders" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>