<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>TheConcernedCat.Shared.Settlement.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- CF-SET-001: the settlement layer is source-shared exactly like the
         companion layer, and belongs to no product. It has no Unity, BepInEx
         or Jötunn reference, which is what lets this project compile it
         directly and exercise the whole recovery surface against a temporary
         directory rather than reason about it.

         This project deliberately references NO product. A product adopting
         settlements adds one <Compile Include> line of its own; nothing here
         creates a dependency in either direction. -->
    <Compile Include="..\Shared\Settlement\**\*.cs" LinkBase="Settlement" />
    <!-- The game-free worker and interop areas are tested here too: they are
         adopted by Foreman and Teamster, and neither product has a test project
         that links shared source (docs/settlement/cart-and-collection). -->
    <Compile Include="..\Shared\Workers\**\*.cs" LinkBase="Workers" />
    <Compile Include="..\Shared\Interop\**\*.cs" LinkBase="Interop" />
    <!-- CF-LAD-001: the ladder domain is game-free for the same reason, and
         Foreman adopts it with one line of its own. -->
    <Compile Include="..\Shared\Ladders\**\*.cs" LinkBase="Ladders" />
    <!-- CF-LAD-002: the climb's own decision core. These two files live beside
         the Valheim adapter they drive (Foreman owns the climb; there is no
         ladder product) but contain no Unity, BepInEx or Jotunn type at all,
         which is exactly why they can be compiled here and exercised with the
         world faked. Two named files, not a glob: the rest of
         ConcernedForeman/Runtime is Valheim-facing and must never appear in a
         test assembly. If the lead would rather they lived under
         src\Shared\Ladders, moving them needs nothing but deleting these two
         lines. -->
    <Compile Include="..\ConcernedForeman\Runtime\Ladders\ClimbSession.cs" Link="Ladders/ClimbSession.cs" />
    <Compile Include="..\ConcernedForeman\Runtime\Ladders\ClimbOptions.cs" Link="Ladders/ClimbOptions.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
